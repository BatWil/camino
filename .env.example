# Copy to .env.local and fill in. Only NEXT_PUBLIC_* values reach the client bundle.
# NEVER put the Supabase service_role key (or any secret) in this app.

# Supabase project (Project Settings → API). Local stack: `npx supabase start` prints both.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public URL where the web/PWA is served (used for deep links and auth redirects).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Custom URL scheme registered by the native apps (camino://events/{id}).
NEXT_PUBLIC_APP_SCHEME=camino
